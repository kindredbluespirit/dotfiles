{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "vllm": {
      "settings": {
        "baseURL": "http://127.0.0.1:8000/v1"
      },
      "models": {
        // Discovery cannot infer tool support from a vLLM server, so declare it.
        "qwen3.8-27b": {
          "name": "Qwen3.8-27B (local)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 262144,
            "output": 32768
          }
        }
      }
    }
  }
}
